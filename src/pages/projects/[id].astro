---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Button from '@ordinate/components/button';
import Figure from '@ordinate/components/figure';
import Link from '@ordinate/components/link';
import Opening from '@ordinate/components/opening';
import Section from '@ordinate/components/section';
import SpaceBetween from '@ordinate/components/space-between';
import TitleBlock from '@ordinate/components/title-block';
import Base from '../../layouts/Base.astro';
import { getProjects } from '../../lib/projects';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, i) => ({ params: { id: project.id }, props: { project, sheet: i + 1 } }));
}

const { project, sheet } = Astro.props;
const { title, intro, year, kind, status, stack, repo, link, images } = project.data;
const { Content } = await render(project);

const repoName = repo?.replace(/\/$/, '').split('/').pop();
// "cardnight.someone.workers.dev" reads as "cardnight on workers.dev"
const host = link ? new URL(link).host.split('.') : [];
const site = host.length > 2 ? `${host[0]} on ${host.slice(-2).join('.')}` : host.join('.');
const number = String(sheet).padStart(2, '0');
const fig = (i: number) => (images.length > 1 ? `${number}${'abcdefgh'[i]}` : number);
// Every screenshot on a page gets the same width: halves for two, thirds for three or more.
const span = images.length >= 3 ? 'span-4' : images.length === 2 ? 'span-6' : '';

const facts = [
  { label: 'Status', value: status },
  { label: 'Year', value: kind ? `${year} · ${kind}` : String(year) },
  { label: 'Built with', value: stack.join(', ') },
  ...(link ? [{ label: 'Live', value: site }] : []),
  ...(repo ? [{ label: 'Source', value: `${repoName} on GitHub` }] : []),
];
---

<Base title={title} description={intro}>
  <Opening variant="statement" title={title} description={intro}>
    <span slot="kicker"><Link href="/projects/">Projects</Link> / sheet {number}</span>
    {
      (link || repo) && (
        <SpaceBetween slot="actions" direction="horizontal" size="xs">
          {link && (
            <Button variant="primary" href={link} external={true}>
              Open {title}
            </Button>
          )}
          {repo && (
            <Button href={repo} external={true}>
              Source on GitHub
            </Button>
          )}
        </SpaceBetween>
      )
    }
  </Opening>

  {
    images.length > 0 && (
      <Section spacing="small">
        <div class="grid">
          <div class="cols">
            {images.map((img, i) => (
              <div class={span}>
                <Figure label={`fig. ${fig(i)}`} caption={img.caption}>
                  <Image
                    slot="media"
                    class="shot"
                    src={img.src}
                    alt={img.alt}
                    widths={[480, 820, 1280]}
                    sizes="(max-width: 688px) 100vw, 588px"
                    loading={i < 2 ? 'eager' : 'lazy'}
                    fetchpriority={i === 0 ? 'high' : undefined}
                  />
                </Figure>
              </div>
            ))}
          </div>
        </div>
      </Section>
    )
  }

  <Section spacing="small">
    <TitleBlock columns={facts.length > 4 ? 5 : 4} items={facts} />
  </Section>

  <Section>
    <div class="rows">
      <div class="row-body">
        <Content />
      </div>
    </div>
  </Section>
</Base>
