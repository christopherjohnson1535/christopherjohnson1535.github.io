---
import Button from '@ordinate/components/button';
import Opening from '@ordinate/components/opening';
import SpaceBetween from '@ordinate/components/space-between';
import Base from '../layouts/Base.astro';
---

<Base title="Not found">
  <Opening
    variant="statement"
    kicker="404 · nothing here"
    title="Nothing at this address."
    description="The page may have moved, or the link may have a typo in it."
  >
    <SpaceBetween slot="actions" direction="horizontal" size="xs">
      <Button variant="primary" href="/">Go to the home page</Button>
      <Button href="/projects/">See all projects</Button>
    </SpaceBetween>
  </Opening>
</Base>
