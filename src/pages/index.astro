---
import { Image } from 'astro:assets';
import Button from '@ordinate/components/button';
import Figure from '@ordinate/components/figure';
import Link from '@ordinate/components/link';
import Opening from '@ordinate/components/opening';
import Section from '@ordinate/components/section';
import SpaceBetween from '@ordinate/components/space-between';
import TitleBlock from '@ordinate/components/title-block';
import Base from '../layouts/Base.astro';
import PlanDrawing from '../components/PlanDrawing.astro';
import SheetIndex from '../components/SheetIndex';
import { getProjects, metaLine, tabCode } from '../lib/projects';
import { github, name, revision } from '../lib/site';

const projects = await getProjects();
const current = projects.find((p) => p.data.status === 'In progress');
const live = projects.filter((p) => p.data.status === 'Live');
const featured = projects.find((p) => p.data.images.length);
const codes = projects.map(tabCode).join(' ');
---

<Base>
  <Opening
    variant="split"
    kicker="Software, mostly for home"
    title="Small software for home."
    description="Things I've built, and the one I'm building now. Written to last."
    mediaCaption={`Sheet 00 · the house, plotted · ${codes}`}
  >
    <SpaceBetween slot="actions" direction="horizontal" size="xs">
      <Button variant="primary" href="/projects/">See the projects</Button>
      <Button href={github} external={true}>GitHub</Button>
    </SpaceBetween>
    <PlanDrawing slot="media" points={projects.map((p) => ({ code: tabCode(p), id: p.id }))} />
  </Opening>

  <Section spacing="small">
    <TitleBlock
      columns={4}
      items={[
        { label: 'Drawn by', value: name },
        { label: 'Projects', value: `${projects.length} · ${live.length} live` },
        { label: 'Now', value: current ? current.data.title : 'Between projects' },
        { label: 'Revision', value: revision },
      ]}
    />
  </Section>

  {
    featured && (
      <Section id="work" heading="Selected work" description="Things I've built, and the one I'm building now.">
        <Link slot="actions" href="/projects/">
          All projects →
        </Link>
        <Figure label={`fig. 01 / ${featured.id}`} credit={metaLine(featured)}>
          <a slot="media" href={`/projects/${featured.id}/`}>
            <Image
              class="shot"
              src={featured.data.images[0].src}
              alt={featured.data.images[0].alt}
              widths={[640, 1280, 1920]}
              sizes="(max-width: 1280px) 100vw, 1180px"
              loading="eager"
            />
          </a>
          <span slot="caption">
            <Link href={`/projects/${featured.id}/`}>{featured.data.title}</Link>: {featured.data.intro}
          </span>
        </Figure>
      </Section>
    )
  }

  <Section id="projects" heading="Sheet index" rule="top" width="narrow">
    <SheetIndex
      items={projects.map((p) => ({
        id: p.id,
        title: p.data.title,
        href: `/projects/${p.id}/`,
        stack: p.data.stack.join(', ').toLowerCase(),
        status: p.data.status,
      }))}
    />
  </Section>
</Base>
