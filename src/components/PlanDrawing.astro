---
// The home page drawing: a plan of a small house drawn onto x and y axes, with each project plotted
// as a point that links to it. The plan draws itself in once per visit. After that a crosshair moves
// from point to point and reads out its coordinates; pointing at or tabbing to a point moves it there,
// and the Pause button stops it. It is SVG and CSS, coloured with Ordinate's tokens, with a short
// script for the crosshair. Without the script the crosshair rests on the first point.
interface Point {
  code: string;
  id: string;
  title: string;
}

interface Props {
  points: Point[];
}

// Where the projects land, in grid units, in the order they are listed.
const spots: [number, number][] = [
  [6.4, 3.6],
  [3.2, 4.6],
  [6.8, 1.6],
  [4.2, 2.4],
  [8.6, 5.2],
  [2.6, 1.2],
];

const ox = 70;
const oy = 330;
const unit = 44;
const px = (x: number) => +(ox + x * unit).toFixed(1);
const py = (y: number) => +(oy - y * unit).toFixed(1);

const points = Astro.props.points.slice(0, spots.length).map((p, i) => {
  const [x, y] = spots[i];
  return { ...p, x, y, cx: px(x), cy: py(y), i };
});

const xs = Array.from({ length: 11 }, (_, i) => i);
const ys = Array.from({ length: 7 }, (_, i) => i);

// Hatching for the kitchen, as 45 degree lines clipped to its walls by hand.
const hatch = (() => {
  const [x0, x1, y0, y1] = [158, 290, 66, 176];
  const out: string[] = [];
  for (let c = x0 - y1; c < x1 - y0; c += 8.5) {
    const pts: [number, number][] = [];
    for (const y of [y0, y1]) if (c + y >= x0 && c + y <= x1) pts.push([c + y, y]);
    for (const x of [x0, x1]) if (x - c >= y0 && x - c <= y1) pts.push([x, x - c]);
    pts.sort((a, b) => a[0] - b[0] || a[1] - b[1]);
    if (pts.length >= 2) {
      const [a, b] = [pts[0], pts[pts.length - 1]];
      out.push(`M${a[0].toFixed(1)} ${a[1].toFixed(1)}L${b[0].toFixed(1)} ${b[1].toFixed(1)}`);
    }
  }
  return out.join('');
})();

// Which point is lit, and which readout shows, follows data-active on the drawing.
const activeCss = points
  .map((p) => `.plan[data-active="${p.i}"] .pt-${p.i}{fill:var(--plan-accent)}.plan[data-active="${p.i}"] .ro-${p.i}{opacity:1}`)
  .join('');
const first = points[0];
---

<div class="plan-wrap">
  <svg class="plan" viewBox="0 0 560 380" data-active="0" role="group" aria-label="Plan of a small house with each project plotted on it">
    <g aria-hidden="true">
      <g class="gridlines">
        {xs.map((i) => <line x1={px(i)} y1={oy} x2={px(i)} y2={py(6.6)} />)}
        {ys.map((i) => <line x1={ox} y1={py(i)} x2={px(10)} y2={py(i)} />)}
      </g>
      <g class="ticks">
        {xs.map((i) => <text class="t mid" x={px(i)} y={oy + 18}>{i}</text>)}
        {ys.map((i) => <text class="t end" x={ox - 12} y={py(i) + 3}>{i}</text>)}
        <text class="t ink" x={ox + 6} y="30">y</text>
        <text class="t ink" x={px(10) + 12} y={oy - 8}>x</text>
      </g>
      <line class="axis" style="--len: 460px" x1={ox} y1={oy} x2={ox + 460} y2={oy}></line>
      <line class="axis" style="--len: 310px" x1={ox} y1={oy} x2={ox} y2={oy - 310}></line>

      <path class="hatch" d={hatch}></path>
      <path class="wall" style="--len: 968px; --d: 1.1s" d="M158 286h264v-220h-264z"></path>
      <path class="wall inner" style="--len: 88px; --d: 2.3s" d="M290 66v88"></path>
      <path class="wall inner" style="--len: 88px; --d: 2.45s" d="M290 198v88"></path>
      <path class="wall inner" style="--len: 88px; --d: 2.6s" d="M158 176h88"></path>
      <path class="door" d="M246 286a44 44 0 0 1 -44 -44"></path>
      <text class="t room" x="174" y="90">KITCHEN</text>
      <text class="t room" x="306" y="90">TABLE</text>
      <text class="t room" x="174" y="200">WORKSHOP</text>

      {points.map((p) => <line class="proj" style={`--d: ${3.4 + p.i * 0.4}s`} x1={ox} y1={p.cy} x2={p.cx} y2={p.cy} />)}

      {
        first && (
          <g class="xh">
            <g class="xh-x" style={`transform: translateX(${first.cx}px)`}>
              <line x1="0" y1={py(6.6)} x2="0" y2={oy} />
              <path d={`M0 ${oy}l-4 7h8z`} />
            </g>
            <g class="xh-y" style={`transform: translateY(${first.cy}px)`}>
              <line x1={ox} y1="0" x2={px(10)} y2="0" />
              <path d={`M${ox} 0l-7 -4v8z`} />
            </g>
            {points.map((p) => (
              <text class={`t ro ro-${p.i}`} x={px(10)} y="30">
                {p.code} · {p.id} · x {p.x} · y {p.y}
              </text>
            ))}
          </g>
        )
      }
    </g>

    {
      points.map((p) => (
        <a class="pt-link" href={`/projects/${p.id}/`} data-i={p.i} data-cx={p.cx} data-cy={p.cy} aria-label={`${p.title}, at x ${p.x}, y ${p.y}`}>
          <circle class="pt-hit" cx={p.cx} cy={p.cy} r="14" />
          <circle class={`pt pt-${p.i}`} style={`--d: ${3.8 + p.i * 0.4}s`} cx={p.cx} cy={p.cy} r="5" />
          <text class="t lbl" style={`--d: ${3.9 + p.i * 0.4}s`} x={p.cx + 10} y={p.cy + 4} aria-hidden="true">
            {p.code}
          </text>
        </a>
      ))
    }
  </svg>
  {
    points.length > 1 && (
      <button class="plan-pause" type="button" aria-pressed="false" hidden>
        <svg viewBox="0 0 12 12" width="12" height="12" aria-hidden="true">
          <path class="i-pause" d="M3 2v8M9 2v8" />
          <path class="i-play" d="M3 2l7 4-7 4z" />
        </svg>
        <span>Pause</span>
      </button>
    )
  }
</div>

<script is:inline>
  // The draw-in plays once per visit; after that the drawing starts finished.
  try {
    if (sessionStorage.getItem('plan-seen')) document.documentElement.classList.add('plan-seen');
    sessionStorage.setItem('plan-seen', '1');
  } catch (e) {}
</script>

<script>
  // The crosshair. It moves on a transition, so pointing at another point mid-move simply retargets it.
  const svg = document.querySelector<SVGSVGElement>('.plan');
  const button = document.querySelector<HTMLButtonElement>('.plan-pause');
  if (svg) {
    const points = [...svg.querySelectorAll<SVGAElement>('.pt-link')];
    const xhX = svg.querySelector<SVGGElement>('.xh-x');
    const xhY = svg.querySelector<SVGGElement>('.xh-y');
    const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const seen = document.documentElement.classList.contains('plan-seen');
    let active = 0;
    let held = false;
    let paused = false;
    let inView = true;

    const show = (i: number) => {
      const p = points[i];
      if (!p || !xhX || !xhY) return;
      active = i;
      svg.dataset.active = String(i);
      xhX.style.transform = `translateX(${p.dataset.cx}px)`;
      xhY.style.transform = `translateY(${p.dataset.cy}px)`;
    };

    points.forEach((p, i) => {
      p.addEventListener('pointerenter', (e) => {
        if (e.pointerType !== 'mouse') return;
        held = true;
        show(i);
      });
      p.addEventListener('pointerleave', () => (held = false));
      p.addEventListener('focus', () => {
        held = true;
        show(i);
      });
      p.addEventListener('blur', () => (held = false));
    });

    if (!still && points.length > 1) {
      new IntersectionObserver(([entry]) => (inView = entry.isIntersecting)).observe(svg);
      const tick = () => {
        if (!paused && !held && inView && !document.hidden) show((active + 1) % points.length);
      };
      window.setTimeout(() => window.setInterval(tick, 3000), seen ? 1500 : 5500);

      if (button) {
        button.hidden = false;
        button.addEventListener('click', () => {
          paused = !paused;
          button.setAttribute('aria-pressed', String(paused));
          button.querySelector('span')!.textContent = paused ? 'Play' : 'Pause';
        });
      }
    }
  }
</script>

<style is:inline set:html={activeCss}></style>

<style is:global>
  .plan-wrap {
    display: grid;
    gap: var(--ord-space-xs);
  }
  .plan {
    --plan-ink: var(--ord-color-text-body);
    --plan-quiet: var(--ord-color-text-secondary);
    --plan-rule: var(--ord-color-border-divider);
    --plan-accent: var(--ord-color-text-accent);
    --plan-ground: var(--ord-color-background-band-accent);
    --ease-out: cubic-bezier(0.23, 1, 0.32, 1);
    --ease-in-out: cubic-bezier(0.77, 0, 0.175, 1);
    display: block;
    inline-size: 100%;
    block-size: auto;
  }
  .plan .gridlines line {
    stroke: var(--plan-rule);
    stroke-dasharray: 1 5;
    animation: plan-fade 0.8s var(--ease-out) 0.1s both;
  }
  .plan .t {
    font-family: var(--ord-font-family-mono);
    font-size: 9px;
    fill: var(--plan-quiet);
  }
  .plan .t.mid {
    text-anchor: middle;
  }
  .plan .t.end {
    text-anchor: end;
  }
  .plan .t.ink {
    fill: var(--plan-ink);
  }
  .plan .ticks {
    animation: plan-fade 0.5s var(--ease-out) 0.9s both;
  }
  .plan .axis,
  .plan .wall {
    fill: none;
    stroke: var(--plan-ink);
    stroke-dasharray: var(--len);
  }
  .plan .axis {
    stroke-width: 1.5;
    animation: plan-draw 0.9s var(--ease-in-out) 0.3s both;
  }
  .plan .wall {
    stroke-width: 5;
    stroke-linecap: square;
    animation: plan-draw 1.4s var(--ease-in-out) var(--d) both;
  }
  .plan .wall.inner {
    stroke-width: 2.5;
    animation-duration: 0.5s;
  }
  .plan .hatch {
    fill: none;
    stroke: var(--ord-color-hatch);
    stroke-width: 2;
    animation: plan-fade 0.6s var(--ease-out) 2.9s both;
  }
  .plan .door {
    fill: none;
    stroke: var(--plan-ink);
    stroke-dasharray: 3 3;
    animation: plan-fade 0.5s var(--ease-out) 2.9s both;
  }
  .plan .room {
    fill: var(--plan-ink);
    animation: plan-fade 0.4s var(--ease-out) 3.1s both;
  }
  .plan .proj {
    stroke: var(--plan-ink);
    stroke-dasharray: 2 3;
    opacity: 0.5;
    transform-box: fill-box;
    transform-origin: 0 50%;
    animation: plan-grow 0.5s var(--ease-out) var(--d) both;
  }
  .plan .pt-hit {
    fill: transparent;
  }
  .plan .pt {
    fill: var(--plan-ground);
    stroke: var(--plan-ink);
    stroke-width: 1.5;
    transform-box: fill-box;
    transform-origin: center;
    transition: fill 200ms ease;
    animation: plan-pop 0.3s var(--ease-out) var(--d) both;
  }
  .plan .lbl {
    font-size: 10px;
    fill: var(--plan-ink);
    animation: plan-fade 0.3s var(--ease-out) var(--d) both;
  }
  .plan .pt-link {
    cursor: pointer;
    outline: none;
  }
  .plan .pt-link:focus-visible .pt-hit {
    stroke: var(--ord-color-border-focus-ring);
    stroke-width: 2;
  }
  .plan .xh {
    animation: plan-fade 0.6s var(--ease-out) 5s both;
  }
  .plan-seen .plan .xh {
    animation-delay: 0s;
  }
  .plan .xh-x,
  .plan .xh-y {
    transition: transform 700ms var(--ease-in-out);
  }
  .plan .xh line {
    stroke: var(--plan-accent);
  }
  .plan .xh path {
    fill: var(--plan-accent);
  }
  .plan .ro {
    font-size: 10px;
    fill: var(--plan-accent);
    text-anchor: end;
    opacity: 0;
    transition: opacity 200ms ease;
  }

  .plan-pause {
    display: inline-flex;
    align-items: center;
    justify-self: end;
    gap: var(--ord-space-xs);
    min-block-size: 32px;
    padding-inline: var(--ord-space-xs);
    border: 0;
    background: none;
    color: var(--ord-color-text-secondary);
    font-family: var(--ord-font-family-mono);
    font-size: var(--ord-font-size-small);
    cursor: pointer;
    transition: color 150ms ease, transform 160ms var(--ease-out, ease-out);
  }
  .plan-pause[hidden] {
    display: none;
  }
  .plan-pause svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }
  .plan-pause .i-play,
  .plan-pause[aria-pressed='true'] .i-pause {
    display: none;
  }
  .plan-pause[aria-pressed='true'] .i-play {
    display: inline;
    fill: currentColor;
  }
  .plan-pause:active {
    transform: scale(0.97);
  }
  .plan-pause:focus-visible {
    outline: var(--ord-border-width-focus-ring) solid var(--ord-color-border-focus-ring);
    outline-offset: var(--ord-border-focus-ring-offset);
  }
  @media (hover: hover) and (pointer: fine) {
    .plan-pause:hover {
      color: var(--ord-color-text-body);
    }
  }
  @media (pointer: coarse) {
    .plan-pause {
      min-block-size: 44px;
    }
  }

  @keyframes plan-fade {
    from {
      opacity: 0;
    }
  }
  @keyframes plan-draw {
    from {
      stroke-dashoffset: var(--len);
    }
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes plan-grow {
    from {
      transform: scaleX(0);
    }
  }
  @keyframes plan-pop {
    from {
      opacity: 0;
      transform: scale(0.6);
    }
  }
  /* Seen already this visit: skip the draw-in. */
  .plan-seen .plan :is(.gridlines line, .ticks, .axis, .wall, .hatch, .door, .room, .proj, .pt, .lbl) {
    animation: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .plan *,
    .plan-pause {
      animation: none !important;
      transition: none !important;
    }
  }
  .ord-motion-disabled .plan * {
    animation: none !important;
    transition: none !important;
  }
</style>
