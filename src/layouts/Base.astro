---
import '@ordinate/global-styles/index.css';
import '../styles/site.css';
import Header from '../components/Header';
import Footer from '../components/Footer';
import { getProjects } from '../lib/projects';
import { name, revision } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = 'Small software for home. Projects I’ve built and the one I’m building now.' } = Astro.props;
const pageTitle = title ? `${title} | ${name}` : name;
const canonical = new URL(Astro.url.pathname, Astro.site);

const projects = await getProjects();
const current = projects.find((p) => p.data.status === 'In progress');
const live = projects.filter((p) => p.data.link);

// Ordinate reads its mode and revision from classes, so they are set here and need no script.
const bodyClass = `ord-dark-mode ord-revision-${revision.replace(/\./g, '-')}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#1e2023" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
  </head>
  <body class={bodyClass}>
    <a class="skip" href="#main">Skip to content</a>
    <Header
      client:load
      path={Astro.url.pathname}
      current={current && { title: current.data.title, href: `/projects/${current.id}/` }}
    />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer
      projects={projects.map((p) => ({ title: p.data.title, href: `/projects/${p.id}/` }))}
      elsewhere={live.map((p) => ({ text: `${p.data.title} (live)`, href: p.data.link! }))}
    />
  </body>
</html>
